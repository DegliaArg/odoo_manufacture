<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.mrp.group.on.create
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='process_operations_setting_container']"
                position="inside"
            >
                <setting
                    id="group_on_create_setting"
                    string="Group MOs on creation"
                    help="Group manually created manufacturing orders of the same product and bill of materials into a single order."
                >
                    <field name="grouping_on_create_enabled" />
                    <div
                        class="content-group mt16"
                        invisible="not grouping_on_create_enabled"
                    >
                        <div class="row">
                            <label
                                for="grouping_on_create_window_days"
                                class="col-lg-4 o_light_label"
                            />
                            <field name="grouping_on_create_window_days" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
